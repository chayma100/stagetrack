    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenCollab",
      "value": ""
    },
    {
      "key": "entrepriseId",
      "value": ""
    },
    {
      "key": "offreId",
      "value": ""
    },
    {
      "key": "candidatureId",
      "value": ""
    }
  ],
