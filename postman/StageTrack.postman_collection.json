{
  "info": {
    "name": "StageTrack API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Exécuter les dossiers dans l'ordre (ou le Collection Runner). Le backend doit tourner sur le port 8080."
